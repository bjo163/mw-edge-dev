{
  "name": "@mw/mw-edge",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:standalone": "concurrently -k -n api,ui \"tsx watch src/server.ts\" \"vite --config web/vite.config.ts\"",
    "start:standalone": "node dist/src/server.js",
    "ui:dev": "vite --config web/vite.config.ts",
    "ui:typecheck": "tsc -p web/tsconfig.json --noEmit",
    "ui:build": "pnpm ui:typecheck && vite build --config web/vite.config.ts",
    "test": "tsx --test test/*.test.ts",
    "test:unit": "tsx --test test/*.test.ts",
    "test:bootstrap": "tsx --test test/bootstrap.test.ts",
    "test:http": "tsx --test test/http.test.ts",
    "test:automation": "bash .github/tests/release-policy.sh && bash .github/tests/branch-state.sh && bash .github/tests/production-readiness.sh && bash .github/tests/steward-workflow-history.sh && bash -n .github/scripts/mw-edge-steward.sh",
    "lint": "pnpm typecheck && tsx scripts/lint.ts",
    "format:check": "tsx scripts/format-check.ts",
    "readiness": "bash .github/scripts/readiness.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "factory:reset": "tsx scripts/factory-reset.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "profiles": "tsx scripts/profiles.ts",
    "plugins:lock:write": "tsx scripts/plugins-lock.ts --write",
    "plugins:lock:check": "tsx scripts/plugins-lock.ts --check",
    "docs:check": "tsx scripts/docs-check.ts",
    "capabilities": "tsx scripts/capabilities.ts",
    "readiness:production": "bash .github/scripts/production-readiness.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "hono": "^4.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
